# Copy this file to a local .env file and fill in real values.
# Do not commit populated .env files.
#
# Layout:
#   - "REQUIRED" values must be provided; they cannot be derived.
#   - "OPTIONAL OVERRIDE" values are derived or defaulted automatically by
#     scripts/lib/bootstrap-env.sh. Leave them commented unless you must override
#     the default. The commented example shows the derived default.

# ============ REQUIRED: Stack topology ============
STACKS=devo,prod
# OPTIONAL OVERRIDE. Defaults to STACKS.
# PROMOTION_PATH=devo,prod

# ============ REQUIRED: Repository identity ============
GITHUB_OWNER=customer-org
DEPLOYMENT_REPO_NAME=customer-ltbase
# OPTIONAL OVERRIDES. Derived/defaulted:
#   TEMPLATE_REPO defaults to Lychee-Technology/ltbase-private-deployment
#   DEPLOYMENT_REPO defaults to ${GITHUB_OWNER}/${DEPLOYMENT_REPO_NAME}
#   DEPLOYMENT_REPO_VISIBILITY defaults to private
#   DEPLOYMENT_REPO_DESCRIPTION defaults to "Customer LTBase deployment repo"
#   GITHUB_ORG / GITHUB_REPO derived from the two values above
# TEMPLATE_REPO=Lychee-Technology/ltbase-private-deployment
# DEPLOYMENT_REPO=customer-org/customer-ltbase
# DEPLOYMENT_REPO_VISIBILITY=private
# DEPLOYMENT_REPO_DESCRIPTION="Customer LTBase deployment repo"

# ============ REQUIRED: Domains (global) ============
OIDC_DISCOVERY_DOMAIN=oidc.customer.example.com
CONTROLPLANE_UI_DOMAIN=admin.customer.example.com

# OPTIONAL OVERRIDES for generated Pages project names.
# Defaults are <DEPLOYMENT_REPO_NAME>-oidc-discovery / <DEPLOYMENT_REPO_NAME>-controlplane-ui.
# OIDC_DISCOVERY_PAGES_PROJECT=customer-ltbase-oidc-discovery
# CONTROLPLANE_UI_PAGES_PROJECT=customer-ltbase-controlplane-ui

# ============ REQUIRED: Cloudflare ============
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_ZONE_ID=replace-with-zone-id
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token

# ============ REQUIRED: AWS per-stack (one set per stack in STACKS) ============
AWS_REGION_DEVO=ap-northeast-1
AWS_REGION_PROD=us-west-2
AWS_ACCOUNT_ID_DEVO=123456789012
AWS_ACCOUNT_ID_PROD=210987654321
# OPTIONAL OVERRIDE. Defaults to ltbase-deploy-<stack>.
# AWS_ROLE_NAME_DEVO=ltbase-deploy-devo
# AWS_ROLE_NAME_PROD=ltbase-deploy-prod

# OPTIONAL OVERRIDES for split-account bootstrap. Set a profile per stack when
# its AWS account differs from the first stack account.
# AWS_PROFILE_DEVO=customer-devo
# AWS_PROFILE_PROD=customer-prod

# OPTIONAL OVERRIDE. Extra IAM principal ARNs that also need direct read/write
# access to the shared Pulumi backend bucket (which lives in the first stack's
# account). Every stack deploy role is granted automatically, and bootstrap also
# auto-derives the IAM role behind each AWS_PROFILE_<STACK> (including IAM
# Identity Center / SSO roles). Set this only for identities bootstrap cannot
# resolve automatically. Comma-separated list of role ARNs.
# PULUMI_BACKEND_ACCESS_PRINCIPAL_ARNS=arn:aws:iam::210987654321:role/aws-reserved/sso.amazonaws.com/us-west-2/AWSReservedSSO_Admin_abc123

# ============ REQUIRED: Pulumi backend ============
PULUMI_STATE_BUCKET=replace-with-pulumi-state-bucket
# OPTIONAL OVERRIDES. Derived/defaulted:
#   PULUMI_KMS_ALIAS defaults to alias/ltbase-pulumi-secrets
#   PULUMI_BACKEND_URL defaults to s3://${PULUMI_STATE_BUCKET}
#   PULUMI_SECRETS_PROVIDER_<STACK> defaults to awskms://${PULUMI_KMS_ALIAS}?region=${AWS_REGION_<STACK>}
# PULUMI_KMS_ALIAS=alias/ltbase-pulumi-secrets
# PULUMI_BACKEND_URL=s3://replace-with-pulumi-state-bucket
# PULUMI_SECRETS_PROVIDER_DEVO=awskms://alias/ltbase-pulumi-secrets?region=ap-northeast-1
# PULUMI_SECRETS_PROVIDER_PROD=awskms://alias/ltbase-pulumi-secrets?region=us-west-2

# ============ REQUIRED: Release ============
LTBASE_RELEASE_ID=v1.0.0
LTBASE_RELEASES_TOKEN=replace-with-releases-token
# OPTIONAL OVERRIDE. Defaults to Lychee-Technology/ltbase-releases.
# LTBASE_RELEASES_REPO=Lychee-Technology/ltbase-releases

# OPTIONAL OVERRIDES. mTLS truststore defaults; keep unless you know otherwise.
# MTLS_TRUSTSTORE_FILE=infra/certs/cloudflare-origin-pull-ca.pem
# MTLS_TRUSTSTORE_KEY=mtls/cloudflare-origin-pull-ca.pem

# ============ REQUIRED: Domains (one set per stack) ============
API_DOMAIN_DEVO=api.devo.customer.example.com
API_DOMAIN_PROD=api.customer.example.com
CONTROL_DOMAIN_DEVO=control.devo.customer.example.com
CONTROL_DOMAIN_PROD=control.customer.example.com
AUTH_DOMAIN_DEVO=auth.devo.customer.example.com
AUTH_DOMAIN_PROD=auth.customer.example.com
# OPTIONAL OVERRIDES. API/auth default to * per stack.
# API_CORS_ALLOW_ORIGINS_DEVO=*
# API_CORS_ALLOW_ORIGINS_PROD=https://app.customer.example.com,https://admin.customer.example.com
# AUTH_CORS_ALLOW_ORIGINS_DEVO=*
# AUTH_CORS_ALLOW_ORIGINS_PROD=https://auth.customer.example.com
# CONTROL_PLANE_CORS_ALLOW_ORIGINS_DEVO=https://ops.customer.example.com
# CONTROL_PLANE_CORS_ALLOW_ORIGINS_PROD=https://control.customer.example.com
# For local Control Plane UI development, append the dev origin as CSV to the devo value
# above, e.g. add ",http://localhost:5173" so it becomes a comma-separated list.
# Control-plane API CORS always includes https://${CONTROLPLANE_UI_DOMAIN} unless you set *.

# ============ REQUIRED: LTBase application ============
PROJECT_ID=11111111-1111-4111-8111-111111111111
# OPTIONAL OVERRIDE. Defaults to infra/auth-providers.<stack>.json.
# AUTH_PROVIDER_CONFIG_FILE_DEVO=infra/auth-providers.devo.json
# AUTH_PROVIDER_CONFIG_FILE_PROD=infra/auth-providers.prod.json

# OPTIONAL OVERRIDES. Derived to:
#   https://${OIDC_DISCOVERY_DOMAIN}/<stack>
#   https://${OIDC_DISCOVERY_DOMAIN}/<stack>/.well-known/jwks.json
# OIDC_ISSUER_URL_DEVO=https://oidc.customer.example.com/devo
# JWKS_URL_DEVO=https://oidc.customer.example.com/devo/.well-known/jwks.json

# OPTIONAL OVERRIDES. Defaults are <DEPLOYMENT_REPO_NAME>-runtime-<stack>,
# <DEPLOYMENT_REPO_NAME>-schema-<stack>, and <DEPLOYMENT_REPO_NAME>-<stack>.
# RUNTIME_BUCKET_DEVO=customer-ltbase-runtime-devo
# SCHEMA_BUCKET_DEVO=customer-ltbase-schema-devo
# TABLE_NAME_DEVO=customer-ltbase-devo

# OPTIONAL OVERRIDES. Defaults are <DEPLOYMENT_REPO_NAME>-oidc-discovery-<stack>.
# OIDC_DISCOVERY_AWS_ROLE_NAME_DEVO=customer-ltbase-oidc-discovery-devo
# OIDC_DISCOVERY_AWS_ROLE_NAME_PROD=customer-ltbase-oidc-discovery-prod

# ============ REQUIRED: Control Plane UI browser config (one set per stack) ============
# The bootstrap currently emits both Firebase and Supabase providers for every stack,
# so each stack must define all four values below. These values are safe to publish.
FIREBASE_API_KEY_DEVO=public-firebase-api-key
FIREBASE_API_KEY_PROD=public-firebase-api-key
FIREBASE_PROJECT_ID_DEVO=firebase-project-id
FIREBASE_PROJECT_ID_PROD=firebase-project-id
SUPABASE_URL_DEVO=https://project.supabase.co
SUPABASE_URL_PROD=https://project.supabase.co
SUPABASE_ANON_KEY_DEVO=public-anon-key
SUPABASE_ANON_KEY_PROD=public-anon-key

# ============ REQUIRED: Gemini ============
GEMINI_API_KEY=replace-with-gemini-api-key
# OPTIONAL OVERRIDE. Application default.
# GEMINI_MODEL=gemini-3.1-flash-lite

# ============ OPTIONAL OVERRIDE: LTBase capability modes ============
# Values must be one of: auto, on, off.
# auto keeps the application's dependency-aware default behavior; on requires
# the feature and fails startup if required config is missing; off disables it.
# LTBASE_LTSEARCH_MODE=auto
# LTBASE_CDC_MODE=auto
# LTBASE_LTFLOW_MODE=auto
# LTBASE_SEMANTIC_MODE=auto
# LTBASE_GOVERNANCE_MODE=auto
# Governance Action stays off by default because it can execute workflow actions.
# LTBASE_GOVERNANCE_ACTION_MODE=off

# ============ OPTIONAL OVERRIDE: DSQL connection defaults ============
# DSQL_PORT=5432
# DSQL_DB=postgres
# DSQL_USER=admin
# DSQL_PROJECT_SCHEMA=ltbase

# Managed deployments resolve and publish DSQL_ENDPOINT automatically during bootstrap.
# Do not set DSQL_ENDPOINT manually in .env.
